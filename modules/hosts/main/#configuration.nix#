{ self, inputs, ... }: {

  flake.nixosModules.noosphereConfiguration = { pkgs, lib, ... }: {
    imports = with self.nixosModules; [
        noosphereHardware
        gaming
	audio
	neovim
      ];

    programs.niri.enable = true;
    programs.niri.package = self.packages."${pkgs.stdenv.hostPlatform.system}".niri;

    boot.loader.systemd-boot.enable = true;
    boot.loader.efi.canTouchEfiVariables = true;

    boot.kernelPackages = pkgs.linuxPackages_latest;

    nix.settings.experimental-features = [ "nix-command" "flakes" ];

    networking.hostName = "noosphere";

    # Automatic upgrading
    system.autoUpgrade.enable = true;
    system.autoUpgrade.dates = "weekly";

    # Automatic cleanup
    nix.gc.automatic = true;
    nix.gc.dates = "daily";
    nix.gc.options = "--delete-older-than 7d";
    nix.settings.auto-optimise-store = true;

    # GPU settings
    hardware.graphics.enable = true;

    hardware.nvidia = {
      modesetting.enable = true;
      powerManagement.enable = false;
      powerManagement.finegrained = false;
      open = true;
      nvidiaSettings = true;
      package = pkgs.linuxPackages_latest.nvidiaPackages.beta;
    };

    hardware.nvidia.prime = {
      # offload = {
      #  enable = true;
      #  enableOffloadCmd = true;
      # };
      sync.enable = true;

      nvidiaBusId = "PCI:1:0:0";
      intelBusId = "PCI:0:2:0";
    };

    services.xserver.videoDrivers = [ "nvidia" "modesetting" ];

    services.displayManager = {
      plasma-login-manager.enable = true;
      defaultSession = "niri";
    };

    networking.networkmanager.enable = true;
    networking.wireless.enable = true;

    hardware.bluetooth.enable = true;
 
    services.printing.enable = true;

#    services.xserver.xkb = {
#      layout = "us";
#      variant = "";
#      options = "grp:alt_shift_toggle";
#    };

    time.timeZone = "Asia/Yekaterinburg";

    i18n.defaultLocale = "ru_RU.UTF-8";

    i18n.extraLocaleSettings = {
      LC_ADDRESS = "ru_RU.UTF-8";
      LC_IDENTIFICATION = "ru_RU.UTF-8";
      LC_MEASUREMENT = "ru_RU.UTF-8";
      LC_MONETARY = "ru_RU.UTF-8";
      LC_NAME = "ru_RU.UTF-8";
      LC_NUMERIC = "ru_RU.UTF-8";
      LC_PAPER = "ru_RU.UTF-8";
      LC_TELEPHONE = "ru_RU.UTF-8";
      LC_TIME = "ru_RU.UTF-8";
    };

    nixpkgs.config.allowUnfree = true;

    users.users.cypher = {
      isNormalUser = true;
      description = "Cypher";
      extraGroups = [ "networkmanager" "wheel" "gamemode" ];
      packages = with pkgs; [
        qbittorrent
        vlc
        obs-studio
        ffmpeg
        telegram-desktop
        gimp
	obsidian
        element-desktop
        discord
        davinci-resolve
        vesktop
        libreoffice-qt
	kdePackages.dolphin
      ];
    };

  environment.systemPackages = with pkgs; [
      alacritty
      emacs
      wget
      fastfetch
      tmux
      rsync
      btop
      tree
      nmap
      psmisc
      bottles
      warehouse
      gparted
      darktable
      inputs.zen-browser.packages.${pkgs.stdenv.hostPlatform.system}.default
  ];

  users.defaultUserShell = pkgs.bash;
  environment.variables.EDITOR = "nvim";

  services.flatpak.enable = true;
  services.lact.enable = true;

  programs.throne = {
    enable = true;
    tunMode.enable = true;
  };

  programs.ssh = {
    extraConfig = "
      Host ecoServer
	Hostname 151.252.80.120
	Port 4572
	User sljusard
   ";
  };

  programs.bash.shellAliases = {
    winboot = "sudo bootctl set-oneshot auto-windows && reboot";
    rebuild = "sudo nixos-rebuild switch";
    niri-displayfix = "niri msg output HDMI-A-1 mode 2560x1440@143.996";
  };

  # networking.firewall.allowedTCPPorts = [ 443 2080 ];
  # networking.firewall.allowedUDPPorts = [ 4096 2080 ];
  # networking.firewall.allowedUDPPortRanges = [
  #   { from = 1000; to = 65535; }
  # ];

  networking.firewall.enable = false;

  system.stateVersion = "25.11"; 
  };
}
