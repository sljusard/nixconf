prefer-no-csd

// Same naming as the screenshot scripts in screenshots.nix
screenshot-path "~/Pictures/Screenshots/%Y%m%d%H%M%S-screenshot.png"

input {
    keyboard {
        xkb {
            layout "us,ru"
            variant "colemak,"
            options "grp:alt_shift_toggle,compose:rctrl"
        }

        repeat-rate 40
        repeat-delay 250
    }

    touchpad {
	disabled-on-external-mouse
        natural-scroll
        tap
    }

    mouse {
        accel-profile "flat"
    }
}

layout {
    background-color "transparent"
    gaps 5
    focus-ring {
        width 2
        active-color "#88C8DF"
    }
}

window-rule {
    geometry-corner-radius 6
    clip-to-geometry true
}

// ===== Satty (screenshots.nix) =====
// screenshot-edit: fullscreen overlay on top of the desktop
window-rule {
    match app-id="^com\\.gabm\\.satty$"

    open-fullscreen true
    open-focused true
    geometry-corner-radius 0

    focus-ring {
        off
    }

    border {
        off
    }

    shadow {
        off
    }
}

// Float every DaVinci Resolve window...
window-rule {
    match app-id="^resolve$"
    exclude title="^DaVinci Resolve"

    open-floating true

    focus-ring {
        off
    }

    border {
        off
    }

    shadow {
        off
    }
}

// ...except the main editor window, which stays tiled.
window-rule {
    match app-id="^resolve$" title="^DaVinci Resolve"
    open-floating false
}

debug {
    render-drm-device "/dev/dri/renderD129"
}
