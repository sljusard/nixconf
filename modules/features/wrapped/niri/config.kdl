prefer-no-csd

input {
    keyboard {
        xkb {
            layout "us,ru"
            variant "colemak,"
            options "grp:alt_shift_toggle,compose:rctrl"
        }

        repeat-rate 40
        repeat-delay 250
    }

    touchpad {
	disabled-on-external-mouse
        natural-scroll
        tap
    }

    mouse {
        accel-profile "flat"
    }
}

layout {
    background-color "transparent"
    gaps 5
    focus-ring {
        width 2
    }
}

window-rule {
    geometry-corner-radius 6
    clip-to-geometry true
}

// Float every DaVinci Resolve window...
window-rule {
    match app-id="^resolve$"
    exclude title="^DaVinci Resolve"

    open-floating true

    focus-ring {
        off
    }

    border {
        off
    }

    shadow {
        off
    }
}

// ...except the main editor window, which stays tiled.
window-rule {
    match app-id="^resolve$" title="^DaVinci Resolve"
    open-floating false
}

debug {
    render-drm-device "/dev/dri/renderD129"
}
