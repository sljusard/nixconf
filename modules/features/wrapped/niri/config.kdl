prefer-no-csd

// Same naming as the screenshot scripts in screenshots.nix
screenshot-path "~/Pictures/Screenshots/%Y%m%d%H%M%S-screenshot.png"

input {
    keyboard {
        repeat-rate 40
        repeat-delay 250
    }

    touchpad {
	disabled-on-external-mouse
        natural-scroll
        tap
    }

    mouse {
        accel-profile "flat"
    }
}

// Windows-like cursor (posy-cursors, added to XCURSOR_PATH in niri.nix)
cursor {
    xcursor-theme "Posy_Cursor"
    xcursor-size 24
}

layout {
    background-color "transparent"
    gaps 5
    focus-ring {
        width 2
        active-color "#88C8DF"
    }
    shadow {
        on
        softness 12
        spread 2
        offset x=0 y=3
        color "#0006"
        inactive-color "#0003"
    }
}

window-rule {
    geometry-corner-radius 6
    clip-to-geometry true
}

// ===== Satty (screenshots.nix) =====
// screenshot-edit: fullscreen overlay on top of the desktop
window-rule {
    match app-id="^com\\.gabm\\.satty$"

    open-fullscreen true
    open-focused true
    geometry-corner-radius 0

    focus-ring {
        off
    }

    border {
        off
    }

    shadow {
        off
    }
}

// Float every DaVinci Resolve window...
window-rule {
    match app-id="^resolve$"
    exclude title="^DaVinci Resolve"

    open-floating true

    focus-ring {
        off
    }

    border {
        off
    }

    shadow {
        off
    }
}

// ...except the main editor window, which stays tiled.
window-rule {
    match app-id="^resolve$" title="^DaVinci Resolve"
    open-floating false
}

debug {
    render-drm-device "/dev/dri/renderD129"
}
